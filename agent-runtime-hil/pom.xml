<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.agentruntime</groupId>
        <artifactId>spring-ai-agent-runtime</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-runtime-hil</artifactId>
    <name>Agent Runtime Human-in-the-Loop</name>
    <description>
        L2 extension: high-risk tool calls are intercepted as an intentional dangling
        tool_call (reusing L1 persistence), exposed via a REST approval API (V1 scope:
        API only, no IM), and resumed by writing the decision back as a ToolMessage.
        Includes the risk-level policy hook upgraded from the demo's RiskPre/PostCheck.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.agentruntime</groupId>
            <artifactId>agent-runtime-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.agentruntime</groupId>
            <artifactId>agent-runtime-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
    </dependencies>

</project>
